# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Deny direct access to internal data files
<FilesMatch "^(overrides\.json|audit\.log|admin-config\.json)$">
  Require all denied
</FilesMatch>

# Optional: uncomment and set your IP(s) to restrict admin pages further
# <FilesMatch "^(admin\.html|admin-api\.php)$">
#   Require ip 203.0.113.10
#   Require ip 198.51.100.0/24
# </FilesMatch>
